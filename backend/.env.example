# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/baby-tracker

# Flask Configuration
FLASK_ENV=development
FLASK_APP=app
DEBUG=True

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=2592000

# API Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Application
APP_NAME=BabyCare360
APP_VERSION=1.0.0
